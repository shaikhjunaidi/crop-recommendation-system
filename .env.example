# ==============================================================================
# Environment Configuration Template for Crop Recommendation System
# Copy this file to .env for local development: cp .env.example .env
# Set these variables in the Render Dashboard under Environment Variables.
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=replace_with_a_secure_random_key_in_production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com

# Database Connection (MySQL)
# Configure either individual DB_* variables or a single DATABASE_URL
DB_NAME=crop_recommender
DB_USER=root
DB_PASSWORD=your_mysql_database_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional: Managed MySQL SSL mode (REQUIRED, PREFERRED, or DISABLED depending on cloud provider)
# DB_SSL_MODE=REQUIRED

# Optional: Single URL format supported by managed MySQL providers (Aiven, TiDB, Clever Cloud, etc.)
# DATABASE_URL=mysql://user:password@host:3306/dbname
